module "esatp_service_account_eks" {
  source = "globe.pe.jfrog.io/hmd-terraform-local__service/aws-eks-service-account/aws"
  version = "~>2.7.0"

  providers = {
    aws.security    = aws.security,
    aws.environment = aws.environment
    gitlab.workload = gitlab.workload
  }

  service_account = var.irsa_name

  //dynamodb_tables_read = ["esatp-generic"]
  //dynamodb_tables_write = ["esatp-generic"]


  allow_s3_cross_account = [
     {
       target_account           = "" 
       allow_cross_account_read  = [""]
       allow_cross_account_write = [""]
     }
  ]

}

