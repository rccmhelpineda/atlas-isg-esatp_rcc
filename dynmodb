module "aws_dynamodb" {
  source = "globe.pe.jfrog.io/hmd-terraform-local__service/aws-dynamodb/aws"
  version = "~>2.7.0"
  providers = {
    aws.environment = aws.environment
    aws.security    = aws.security
  }

  name           = "generic"
  billing_mode   = "PAY_PER_REQUEST"
  
  # Primary Key
  hash_key = {
    name = "PK"
    type = "S"
  }

  range_key = {
    name = "SK"
    type = "S"
  }

  # Attribute Definitions
  attributes = [
    {
      name = "PK"
      type = "S"
    },
    {
      name = "SK"
      type = "S"
    },
    {
      name = "GSI1PK"
      type = "S"
    },
    {
      name = "GSI1SK"
      type = "S"
    },
    {
      name = "GSI2PK"
      type = "S"
    },
    {
      name = "GSI2SK"
      type = "S"
    },
    {
      name = "GSI3PK"
      type = "S"
    },
    {
      name = "GSI3SK"
      type = "S"
    },
   {
      name = "GSI4PK"
      type = "S"
    },
    {
      name = "GSI4SK"
      type = "S"
    },
   {
      name = "GSI5PK"
      type = "S"
    },
    {
      name = "GSI5SK"
      type = "S"
    },
   {
      name = "GSI6PK"
      type = "S"
    },
    {
      name = "GSI6SK"
      type = "S"
    }      
  ]

  # Global Secondary Indexes
  global_secondary_indexes = [
    {
      name               = "GSI0"
      hash_key           = "SK"
      range_key          = "PK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    },
    {
      name               = "GSI1"
      hash_key           = "GSI1PK"
      range_key          = "GSI1SK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    },
    {
      name               = "GSI2"
      hash_key           = "GSI2PK"
      range_key          = "GSI2SK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    },
    {
      name               = "GSI3"
      hash_key           = "GSI3PK"
      range_key          = "GSI3SK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    },
    {
      name               = "GSI4"
      hash_key           = "GSI4PK"
      range_key          = "GSI4SK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    },
    {
      name               = "GSI5"
      hash_key           = "GSI5PK"
      range_key          = "GSI5SK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    },
    {
      name               = "GSI6"
      hash_key           = "GSI6PK"
      range_key          = "GSI6SK"
      projection_type    = "ALL"
      read_capacity      = var.read_capacity
      write_capacity     = var.write_capacity
    }
  ]
  
  ttl_attribute_name = "ExpirationTime"
  enable_dynamodb_stream   = false
}