module "secrets_manager_module" {
  source = "globe.pe.jfrog.io/hmd-terraform-local__service/aws-secrets-manager/aws"

  providers = {
    aws.security    = aws.security,
    aws.environment = aws.environment
  }

  name = var.secret_sme_name

  db_name = var.postgres_name
  db_engine = var.secret_sme_db_engine

  recovery_window_in_days = var.secret_sme_recovery_days
  tags = {
    description = "secret with dbinsanceidentifier"
    database    = "aurorapsql"
    date        = "08/20/2026"
  }

  #rotation_schedule_expression = "rate(8 hours)"
  rotation_duration = var.secret_sme_rotation_days
  #depends_on = [ module.aurora_module ] # needed to provision the multi user lambda first that will be used here

}

module "secrets_manager_module_2" {
  source = "globe.pe.jfrog.io/hmd-terraform-local__service/aws-secrets-manager/aws"

  providers = {
    aws.security    = aws.security,
    aws.environment = aws.environment
  }

  name = var.secret_adm_name

  db_name = var.postgres_name
  db_engine = var.secret_adm_db_engine

  recovery_window_in_days = var.secret_adm_recovery_days
  tags = {
    description = "secret with dbinsanceidentifier"
    database    = "aurorapsql"
    date        = "08/27/2026"
  }

  #rotation_schedule_expression = "rate(8 hours)"
  rotation_duration = var.secret_sme_rotation_days
  #depends_on = [ module.aurora_module ] # needed to provision the multi user lambda first that will be used here

}

module "secrets_manager_sftp_rsakey" {
  source = "globe.pe.jfrog.io/hmd-terraform-local__service/aws-secrets-manager/aws"
  providers = {
    aws.security    = aws.security,
    aws.environment = aws.environment
  }

  name = "rsapriv"
  recovery_window_in_days = 7
  tags = {
    description = "non-db secret for sftp rsa private key"
    database    = "non-db"
    date        = "08/21/2026"
  }
}

module "secrets_manager_sap_db_user" {
  source = "globe.pe.jfrog.io/hmd-terraform-local__service/aws-secrets-manager/aws"
  providers = {
    aws.security    = aws.security,
    aws.environment = aws.environment
  }

  name = "sapconn"
  recovery_window_in_days = 7
  tags = {
    description = "non-db secret for sap db connection"
    database    = "non-db"
    date        = "08/21/2026"
  }

}
